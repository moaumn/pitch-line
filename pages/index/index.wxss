/* pages/index/index.wxss */

.container {
  background-color: #0f0f15;
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  overflow: hidden;
}

/* 统一动画与过渡 */
.step-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: fadeTransition 0.4s ease-out;
}

@keyframes fadeTransition {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 第一步：音频准备欢迎页样式 ==================== */
.welcome-step {
  padding: 40rpx;
  justify-content: space-between;
}

.welcome-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 4vh;
}

/* LOGO 动态音波图 */
.logo-animation {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  height: 60rpx;
  margin-bottom: 24rpx;
}

.logo-bar {
  width: 6rpx;
  background: linear-gradient(to top, #2979ff, #00e5ff);
  border-radius: 3rpx;
  animation: bounceLogo 0.8s ease-in-out infinite alternate;
}

.lb-1 { height: 24rpx; animation-delay: 0.1s; }
.lb-2 { height: 48rpx; animation-delay: 0.3s; }
.lb-3 { height: 56rpx; animation-delay: 0.5s; }
.lb-4 { height: 36rpx; animation-delay: 0.2s; }
.lb-5 { height: 18rpx; animation-delay: 0.4s; }

@keyframes bounceLogo {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1.1); }
}

.logo-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  text-shadow: 0 0 15rpx rgba(0, 229, 255, 0.4);
}

.logo-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 8rpx;
  text-transform: uppercase;
  margin-top: 6rpx;
}

.welcome-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 16rpx;
}

/* 垂直卡片列表 */
.upload-wizard-cards {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  width: 100%;
  margin: 4vh 0;
}

.wizard-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 30rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
}

.wizard-card:active {
  background: rgba(255, 255, 255, 0.04);
}

.required-border {
  border-color: rgba(255, 51, 102, 0.2);
}

.wizard-card-loaded {
  background: rgba(255, 255, 255, 0.04);
  border-style: solid;
  border-color: rgba(0, 229, 255, 0.25);
  box-shadow: 0 0 20rpx rgba(0, 229, 255, 0.05);
}

.wizard-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bg-blue {
  background: rgba(41, 121, 255, 0.1);
  border: 1px solid rgba(41, 121, 255, 0.2);
  box-shadow: 0 0 10rpx rgba(41, 121, 255, 0.1);
}

.bg-red {
  background: rgba(255, 51, 102, 0.1);
  border: 1px solid rgba(255, 51, 102, 0.2);
  box-shadow: 0 0 10rpx rgba(255, 51, 102, 0.1);
}

.wizard-card-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.wizard-card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.wizard-card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.wizard-card-tag {
  font-size: 16rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.tag-optional {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.5);
}

.tag-required {
  background: rgba(255, 51, 102, 0.15);
  color: #ff3366;
}

.wizard-card-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

.wizard-card-meta {
  display: flex;
  flex-direction: column;
}

.file-name-txt {
  font-size: 22rpx;
  color: #00e5ff;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  max-width: 320rpx;
  margin-bottom: 2rpx;
}

.file-size-dur {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.wizard-card-action {
  font-size: 20rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-left: 20rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.wizard-card-loaded .wizard-card-action {
  border-color: rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.05);
}

/* 确认进入按钮 */
.wizard-footer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 5vh;
  width: 100%;
}

.btn-enter-practice {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.btn-enter-disabled {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.btn-enter-active {
  background: linear-gradient(135deg, #2979ff, #00e5ff);
  color: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 229, 255, 0.35);
  animation: buttonPulse 1.8s infinite alternate;
}

@keyframes buttonPulse {
  0% { transform: scale(1); box-shadow: 0 4rpx 20rpx rgba(0, 229, 255, 0.25); }
  100% { transform: scale(1.015); box-shadow: 0 8rpx 35rpx rgba(0, 229, 255, 0.45); }
}

.footer-tip-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-top: 20rpx;
  letter-spacing: 0.5rpx;
}


/* ==================== 第二步：主界面工作舱样式 ==================== */
.dashboard-step {
  padding: 15rpx 24rpx 20rpx 24rpx;
}

.dashboard-header-row {
  height: 6vh;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-back-nav {
  display: flex;
  align-items: center;
  background: rgba(0, 229, 255, 0.05);
  border: 1px solid rgba(0, 229, 255, 0.25);
  padding: 10rpx 24rpx;
  border-radius: 14rpx;
  transition: all 0.2s ease;
  box-shadow: 0 0 10rpx rgba(0, 229, 255, 0.1);
}

.btn-back-nav:active {
  background: rgba(0, 229, 255, 0.15);
  transform: scale(0.96);
}

.back-arrow {
  font-size: 36rpx;
  color: #00e5ff;
  margin-right: 10rpx;
  position: relative;
  top: -2rpx;
}

.back-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: #00e5ff;
}

.current-track-badge {
  display: flex;
  align-items: center;
  background: rgba(0, 229, 255, 0.05);
  border: 1px solid rgba(0, 229, 255, 0.15);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  max-width: 350rpx;
}

.badge-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #00e5ff;
  box-shadow: 0 0 6rpx #00e5ff;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.badge-text {
  font-size: 20rpx;
  color: #00e5ff;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 【70%高度】：可视化视窗 */
.visualizer-section {
  height: 64vh;
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.note-sidebar {
  width: 90rpx;
  height: 100%;
  position: relative;
  box-sizing: border-box;
  margin-right: 12rpx;
}

.note-sidebar-empty {
  width: 90rpx;
  height: 100%;
  position: relative;
  box-sizing: border-box;
  margin-right: 12rpx;
}

.note-axis-label {
  position: absolute;
  right: 6rpx;
  transform: translateY(-50%);
  font-size: 24rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.45);
  font-family: "Courier New", Courier, monospace;
}

.canvas-wrapper {
  flex: 1;
  height: 100%;
  position: relative;
  background: linear-gradient(180deg, #12121e 0%, #0c0c14 100%);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.6);
}

.pitch-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.canvas-grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.grid-line {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1px;
  background: rgba(255, 255, 255, 0.035);
}

.canvas-empty-state {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(12, 12, 20, 0.9);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.empty-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 1rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3px solid rgba(0, 229, 255, 0.1);
  border-top: 3px solid #00e5ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 【30%高度】：控制模块 */
.bottom-section {
  height: 28vh;
  margin-top: 15rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  width: 100%;
  box-sizing: border-box;
  flex: 1;
}

.operations-panel {
  display: flex;
  flex-direction: column;
  padding: 15rpx 20rpx;
}

.tabs-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding-bottom: 8rpx;
}

.tabs-selectors {
  display: flex;
  gap: 20rpx;
}

.tab-item {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.4);
  padding: 6rpx 10rpx;
  position: relative;
  transition: all 0.2s ease;
}

.active-tab {
  color: #00e5ff;
}

.active-tab::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 100%;
  height: 4rpx;
  background-color: #00e5ff;
  border-radius: 2rpx;
  box-shadow: 0 0 6rpx #00e5ff;
}

.tab-contents {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 自动同步对唱 */
.tab-pane-auto {
  width: 100%;
}

.pane-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.pane-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 15rpx;
}

.pane-status-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.pane-help-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  line-height: 1.3;
}

.pane-action {
  margin: 0 20rpx;
}

.btn-record-auto {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #ff3366;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12rpx rgba(255, 51, 102, 0.15);
  transition: all 0.2s ease;
}

.btn-record-auto:active {
  transform: scale(0.92);
}

.auto-inner-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #ff3366;
  transition: all 0.2s ease;
}

.auto-recording {
  border-color: #00e676;
  box-shadow: 0 0 16rpx rgba(0, 230, 118, 0.35);
  animation: pulsing 1.5s infinite;
}

.auto-recording .auto-inner-circle {
  background-color: #00e676;
  border-radius: 6rpx;
  width: 24rpx;
  height: 24rpx;
}

@keyframes pulsing {
  0% { box-shadow: 0 0 10rpx rgba(0, 230, 118, 0.2); }
  50% { box-shadow: 0 0 20rpx rgba(0, 230, 118, 0.5); }
  100% { box-shadow: 0 0 10rpx rgba(0, 230, 118, 0.2); }
}

.pane-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.02);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
  min-width: 90rpx;
}

.pane-score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-bottom: 2rpx;
}

.pane-score-val {
  font-size: 32rpx;
  font-weight: 800;
}

/* 影子跟读模式 */
.tab-pane-shadow {
  width: 100%;
}

.shadow-layout {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.gesture-hear-strip {
  width: 100%;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.gesture-hear-strip-active {
  background: rgba(41, 121, 255, 0.08);
  border-color: rgba(41, 121, 255, 0.25);
}

.hear-strip-text {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.5rpx;
}

.gesture-hear-strip-active .hear-strip-text {
  color: #2979ff;
}

.soundwave-mini {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 20rpx;
  margin-right: 12rpx;
}

.mini-bar {
  width: 3rpx;
  background-color: #2979ff;
  border-radius: 1rpx;
  animation: bounceMini 0.5s ease-in-out infinite alternate;
}

.b1 { height: 8rpx; animation-delay: 0.1s; }
.b2 { height: 18rpx; animation-delay: 0.3s; }
.b3 { height: 12rpx; animation-delay: 0.2s; }
.b4 { height: 6rpx; animation-delay: 0.4s; }

@keyframes bounceMini {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1.1); }
}

.shadow-actions-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.shadow-sub-actions {
  display: flex;
  gap: 12rpx;
  flex: 1;
}

.shadow-act-btn {
  flex: 1;
  height: 56rpx;
  font-size: 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  font-weight: bold;
}

.shadow-btn-rec {
  background: rgba(255, 51, 102, 0.08);
  color: #ff3366;
  border: 1px solid rgba(255, 51, 102, 0.2);
}

.shadow-btn-rec-active {
  background: #ff3366;
  color: #ffffff;
  box-shadow: 0 0 10rpx rgba(255, 51, 102, 0.35);
}

.shadow-btn-normal {
  background: rgba(255, 255, 255, 0.03);
  color: #d0d0d0;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.shadow-btn-primary {
  background: linear-gradient(135deg, #2979ff, #00e5ff);
  color: #ffffff;
}

.shadow-mini-score {
  display: flex;
  align-items: baseline;
  background: rgba(0, 230, 118, 0.06);
  border: 1px solid rgba(0, 230, 118, 0.15);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 15rpx;
}

.mini-score-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #00e676;
  text-shadow: 0 0 6rpx rgba(0, 230, 118, 0.2);
  font-family: "Outfit", sans-serif;
}

.mini-score-unit {
  font-size: 20rpx;
  color: #00e676;
  margin-left: 2rpx;
  font-weight: 600;
}

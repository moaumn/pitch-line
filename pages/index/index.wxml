<!--pages/index/index.wxml-->
<view class="container">

  <!-- ==================== 第一步：音频准备与选歌界面 ==================== -->
  <view class="step-wrapper welcome-step" wx:if="{{pageStep === 1}}">
    <!-- 品牌标志与介绍 -->
    <view class="welcome-header">
      <view class="logo-animation">
        <view class="logo-bar lb-1"></view>
        <view class="logo-bar lb-2"></view>
        <view class="logo-bar lb-3"></view>
        <view class="logo-bar lb-4"></view>
        <view class="logo-bar lb-5"></view>
      </view>
      <text class="logo-title glow-text-blue">准 音 线</text>
      <text class="logo-subtitle">PITCHLINE STUDIO</text>
      <text class="welcome-desc">轻量化离线音高纠正与视觉练习坊</text>
    </view>

    <!-- 垂直大卡片导入选择器 -->
    <view class="upload-wizard-cards">
      <!-- 伴奏导入卡片 -->
      <view class="wizard-card {{trackA ? 'wizard-card-loaded' : ''}}" bindtap="importTrackA">
        <view class="wizard-card-icon bg-blue">🎵</view>
        <view class="wizard-card-details">
          <view class="wizard-card-title-row">
            <text class="wizard-card-name">导入伴奏轨 (A轨)</text>
            <text class="wizard-card-tag tag-optional">可选</text>
          </view>
          <text class="wizard-card-sub" wx:if="{{!trackA}}">支持 MP4 / MOV / MP3 / WAV 格式文件</text>
          <view class="wizard-card-meta" wx:else>
            <text class="file-name-txt">{{trackA.name}}</text>
            <view class="file-size-dur">{{trackA.displaySize}} · {{trackA.displayDuration}}</view>
          </view>
        </view>
        <view class="wizard-card-action" catchtap="{{trackA ? 'removeTrackA' : 'importTrackA'}}">
          <text class="action-txt">{{trackA ? '清除' : '选择'}}</text>
        </view>
      </view>

      <!-- 原唱干声音频卡片 -->
      <view class="wizard-card required-border {{trackB ? 'wizard-card-loaded' : ''}}" bindtap="importTrackB">
        <view class="wizard-card-icon bg-red">🎙️</view>
        <view class="wizard-card-details">
          <view class="wizard-card-title-row">
            <text class="wizard-card-name">导入原唱干声轨 (B轨)</text>
            <text class="wizard-card-tag tag-required">必填</text>
          </view>
          <text class="wizard-card-sub" wx:if="{{!trackB}}">必须是已人声分离的纯人声干声 (MP3/WAV)</text>
          <view class="wizard-card-meta" wx:else>
            <text class="file-name-txt">{{trackB.name}}</text>
            <view class="file-size-dur">{{trackB.displaySize}} · {{trackB.displayDuration}}</view>
          </view>
        </view>
        <view class="wizard-card-action" catchtap="{{trackB ? 'removeTrackB' : 'importTrackB'}}">
          <text class="action-txt">{{trackB ? '清除' : '选择'}}</text>
        </view>
      </view>
    </view>

    <!-- 底部确认进入练习按钮 -->
    <view class="wizard-footer-action">
      <button class="btn-enter-practice {{trackB ? 'btn-enter-active' : 'btn-enter-disabled'}}" 
              bindtap="enterPractice" 
              disabled="{{!trackB}}">
        <text>{{trackB ? '开始音高练习' : '请先导入原唱干声轨'}}</text>
      </button>
      <text class="footer-tip-text">数据完全在手机本地多线程解码，规避数据上传，离线安全</text>
    </view>
  </view>


  <!-- ==================== 第二步：主界面（音高显示 + 练习控制） ==================== -->
  <view class="step-wrapper dashboard-step" wx:if="{{pageStep === 2}}">
    
    <!-- 顶部状态与返回栏 -->
    <view class="dashboard-header-row">
      <view class="btn-back-nav" bindtap="backToUpload">
        <text class="back-arrow">‹</text>
        <text class="back-txt">重新选歌</text>
      </view>
      <view class="current-track-badge">
        <view class="badge-dot"></view>
        <text class="badge-text">{{trackB.name}}</text>
      </view>
    </view>

    <!-- 【70% 高度】音高展示区 -->
    <view class="visualizer-section">
      <!-- 左侧：根据音频音高动态渲染的音阶 Y 轴 -->
      <view class="note-sidebar">
        <view class="note-axis-label" 
              wx:for="{{yAxisNotes}}" 
              wx:key="midi" 
              style="top: {{item.yPercent}}%;">
          <text>{{item.name}}</text>
        </view>
      </view>

      <!-- 右侧：音高 Canvas 绘图框 -->
      <view class="canvas-wrapper">
        <canvas type="2d" id="pitchCanvas" class="pitch-canvas"></canvas>
        <!-- 辅助横向网格参考线 -->
        <view class="canvas-grid-lines">
          <view class="grid-line" 
                wx:for="{{yAxisNotes}}" 
                wx:key="midi" 
                style="top: {{item.yPercent}}%;"
                wx:if="{{item.midi % 12 === 0}}">
          </view>
        </view>
        
        <!-- 预解码转圈状态 -->
        <view class="canvas-empty-state" wx:if="{{decoding}}">
          <view class="loading-spinner"></view>
          <text class="empty-text">原唱音轨解码分析中...</text>
        </view>
      </view>
    </view>

    <!-- 【30% 高度】控制操作区 -->
    <view class="bottom-section">
      <view class="operations-panel glass-card">
        <!-- 选项卡 Tabs 切换头 -->
        <view class="tabs-header-row">
          <view class="tabs-selectors">
            <view class="tab-item {{activeMode === 'auto' ? 'active-tab' : ''}}" bindtap="switchMode" data-mode="auto">
              <text>自动同步模式</text>
            </view>
            <view class="tab-item {{activeMode === 'shadow' ? 'active-tab' : ''}}" bindtap="switchMode" data-mode="shadow">
              <text>影子跟读模式</text>
            </view>
          </view>
        </view>

        <!-- Tab 内容控制器面板 -->
        <view class="tab-contents">
          
          <!-- 1. 自动对唱模式控制器 -->
          <view class="tab-pane-auto" wx:if="{{activeMode === 'auto'}}">
            <view class="pane-layout">
              <view class="pane-info">
                <text class="pane-status-text">{{isAutoPlaying ? '录制伴唱中...' : '准备就绪'}}</text>
                <text class="pane-help-text">伴奏已载入，佩戴耳机能通过硬件降噪(AEC)过滤杂音。</text>
              </view>
              <view class="pane-action">
                <view class="btn-record-auto {{isAutoPlaying ? 'auto-recording' : ''}}" bindtap="toggleAutoMode">
                  <view class="auto-inner-circle"></view>
                </view>
              </view>
              <view class="pane-score" wx:if="{{lastScore !== null}}">
                <text class="pane-score-label">相似度得分</text>
                <text class="pane-score-val glow-text-green">{{lastScore}}</text>
              </view>
            </view>
          </view>

          <!-- 2. 影子跟读模式控制器 -->
          <view class="tab-pane-shadow" wx:if="{{activeMode === 'shadow'}}">
            <view class="shadow-layout">
              <!-- 长按定位手势槽 -->
              <view class="gesture-hear-strip" 
                    bindtouchstart="onTouchStart" 
                    bindtouchend="onTouchEnd"
                    hover-class="gesture-hear-strip-active">
                <view class="soundwave-mini" wx:if="{{isListening}}">
                  <view class="mini-bar b1"></view>
                  <view class="mini-bar b2"></view>
                  <view class="mini-bar b3"></view>
                  <view class="mini-bar b4"></view>
                </view>
                <text class="hear-strip-text">{{isListening ? '松开即刻完成定位' : '长按聆听并卡点定位 ' + (shadowSegment.duration > 0 ? '[' + shadowSegment.displayDuration + ']' : '')}}</text>
              </view>

              <!-- 跟读清唱与打分动作行 -->
              <view class="shadow-actions-row" wx:if="{{shadowSegment.duration > 0}}">
                <view class="shadow-sub-actions">
                  <button class="shadow-act-btn {{isShadowRecording ? 'shadow-btn-rec-active' : 'shadow-btn-rec'}}" bindtap="toggleShadowRecording">
                    <text>{{isShadowRecording ? '停止' : '录制此段'}}</text>
                  </button>
                  <button class="shadow-act-btn shadow-btn-normal" bindtap="playShadowUserVoice" disabled="{{!userRecordPath}}">
                    <text>回放我的</text>
                  </button>
                  <button class="shadow-act-btn shadow-btn-primary" bindtap="startComparison" disabled="{{!userRecordPath || isShadowRecording}}">
                    <text>对比评分</text>
                  </button>
                </view>

                <view class="shadow-mini-score" wx:if="{{lastScore !== null}}">
                  <text class="mini-score-val">{{lastScore}}</text>
                  <text class="mini-score-unit">分</text>
                </view>
              </view>
            </view>
          </view>

        </view>
      </view>
    </view>

  </view>

</view>
